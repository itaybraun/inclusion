{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "friendlyName", "roleName", "description", "color", "status", "defaultLanguage", "supportedLanguages"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "friendlyName": { "type": "string", "minLength": 1 },
    "roleName": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "status": { "enum": ["draft", "published", "archived"] },
    "defaultLanguage": { "enum": ["en", "he", "ar"] },
    "supportedLanguages": {
      "type": "array",
      "items": { "enum": ["en", "he", "ar"] },
      "uniqueItems": true
    }
  }
}
