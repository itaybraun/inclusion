{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "advisorId", "categoryId", "status", "featured", "sortOrder", "question", "keywords", "answerFiles", "relatedAdvisors", "media"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "advisorId": { "type": "string" },
      "categoryId": { "type": "string" },
      "status": { "enum": ["draft", "in-review", "needs-translation", "published", "archived"] },
      "featured": { "type": "boolean" },
      "sortOrder": { "type": "integer", "minimum": 1 },
      "question": { "type": "object" },
      "shortQuestion": {
        "type": "object",
        "properties": {
          "en": { "type": "string" },
          "he": { "type": "string" },
          "ar": { "type": "string" }
        },
        "additionalProperties": false
      },
      "keywords": { "type": "object" },
      "translationStatus": {
        "type": "object",
        "properties": {
          "en": { "enum": ["draft", "needs-human-review", "reviewed"] },
          "he": { "enum": ["draft", "needs-human-review", "reviewed"] },
          "ar": { "enum": ["draft", "needs-human-review", "reviewed"] }
        },
        "additionalProperties": false
      },
      "answerFiles": {
        "type": "object",
        "required": ["en"],
        "properties": {
          "en": { "type": "string" },
          "he": { "type": "string" },
          "ar": { "type": "string" }
        },
        "additionalProperties": false
      },
      "relatedAdvisors": { "type": "array", "items": { "type": "string" } },
      "media": { "type": ["string", "null"] }
    }
  }
}
